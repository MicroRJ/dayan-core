compiler := "clang-cl"
librarian := "lib"
compile_options := " /nologo /std:c11 /W4 /WX /Zi /Od /Iinclude"

prepare := {
	name = "prepare build directory",
	command_line = "cmd /c if not exist build\\obj mkdir build\\obj",
	inputs = {},
	outputs = { "build/obj" },
	include_dirs = {},
	dependencies = {},
}

compile_platform := {
	name = "compile platform",
	command_line = f"${compiler}${compile_options} /c src/platform_win32.c /Fobuild/obj/platform.obj /Fdbuild/obj/platform.pdb",
	inputs = { "src/platform_win32.c" },
	outputs = { "build/obj/platform.obj" },
	include_dirs = { "include" },
	dependencies = { prepare },
}

compile_dayan := {
	name = "compile dayan",
	command_line = f"${compiler}${compile_options} /c src/dayan.c /Fobuild/obj/dayan.obj /Fdbuild/obj/dayan.pdb",
	inputs = { "src/dayan.c", "src/dayan_memory.h", "include/dayan.h" },
	outputs = { "build/obj/dayan.obj" },
	include_dirs = { "include" },
	dependencies = { prepare },
}

compile_dayan_memory := {
	name = "compile dayan memory",
	command_line = f"${compiler}${compile_options} /c src/dayan_memory.c /Fobuild/obj/dayan_memory.obj /Fdbuild/obj/dayan_memory.pdb",
	inputs = {
		"src/dayan_memory.c",
		"src/dayan_memory.h",
		"src/win32/dayan_memory.c",
		"include/dayan.h",
	},
	outputs = { "build/obj/dayan_memory.obj" },
	include_dirs = { "include" },
	dependencies = { prepare },
}

compile_dayan_file := {
	name = "compile dayan file",
	command_line = f"${compiler}${compile_options} /c src/dayan_file.c /Fobuild/obj/dayan_file.obj /Fdbuild/obj/dayan_file.pdb",
	inputs = {
		"src/dayan_file.c",
		"src/win32/dayan_file.c",
		"include/dayan.h",
	},
	outputs = { "build/obj/dayan_file.obj" },
	include_dirs = { "include" },
	dependencies = { prepare },
}

compile_dayan_path := {
	name = "compile dayan path",
	command_line = f"${compiler}${compile_options} /c src/dayan_path.c /Fobuild/obj/dayan_path.obj /Fdbuild/obj/dayan_path.pdb",
	inputs = {
		"src/dayan_path.c",
		"src/win32/dayan_path.c",
		"include/dayan.h",
	},
	outputs = { "build/obj/dayan_path.obj" },
	include_dirs = { "include" },
	dependencies = { prepare },
}

compile_dayan_env := {
	name = "compile dayan environment",
	command_line = f"${compiler}${compile_options} /c src/dayan_env.c /Fobuild/obj/dayan_env.obj /Fdbuild/obj/dayan_env.pdb",
	inputs = {
		"src/dayan_env.c",
		"src/win32/dayan_env.c",
		"include/dayan.h",
	},
	outputs = { "build/obj/dayan_env.obj" },
	include_dirs = { "include" },
	dependencies = { prepare },
}

compile_dayan_process := {
	name = "compile dayan process",
	command_line = f"${compiler}${compile_options} /c src/dayan_process.c /Fobuild/obj/dayan_process.obj /Fdbuild/obj/dayan_process.pdb",
	inputs = {
		"src/dayan_process.c",
		"src/win32/dayan_process.c",
		"include/dayan.h",
	},
	outputs = { "build/obj/dayan_process.obj" },
	include_dirs = { "include" },
	dependencies = { prepare },
}

dayan_library := {
	name = "archive dayan.lib",
	command_line = f"${librarian} /nologo /out:build/dayan.lib build/obj/dayan.obj build/obj/dayan_memory.obj build/obj/dayan_file.obj build/obj/dayan_path.obj build/obj/dayan_env.obj build/obj/dayan_process.obj build/obj/platform.obj",
	inputs = { "build/obj/dayan.obj", "build/obj/dayan_memory.obj", "build/obj/dayan_file.obj", "build/obj/dayan_path.obj", "build/obj/dayan_env.obj", "build/obj/dayan_process.obj", "build/obj/platform.obj" },
	outputs = { "build/dayan.lib" },
	include_dirs = {},
	dependencies = { compile_dayan, compile_dayan_memory, compile_dayan_file, compile_dayan_path, compile_dayan_env, compile_dayan_process, compile_platform },
}

compile_tests := {
	name = "compile platform tests",
	command_line = f"${compiler}${compile_options} /c tests/platform_tests.c /Fobuild/obj/platform_tests.obj /Fdbuild/obj/platform_tests.pdb",
	inputs = { "tests/platform_tests.c" },
	outputs = { "build/obj/platform_tests.obj" },
	include_dirs = { "include" },
	dependencies = { prepare },
}

link_tests := {
	name = "link platform tests",
	command_line = f"${compiler} /nologo build/obj/platform_tests.obj build/dayan.lib /Febuild/platform_tests.exe /link /DEBUG /PDB:build/platform_tests.pdb",
	inputs = { "build/obj/platform_tests.obj", "build/dayan.lib" },
	outputs = { "build/platform_tests.exe" },
	include_dirs = {},
	dependencies = { compile_tests, dayan_library },
}

run_tests := {
	name = "run platform tests",
	command_line = "build\\platform_tests.exe",
	inputs = { "build/platform_tests.exe" },
	outputs = {},
	include_dirs = {},
	dependencies = { link_tests },
}

options := {
	workers = 4,
	verbosity = 0,
}

entries := {}

entries.lib = fun() {
	ret manny.build({ targets = { dayan_library }, options = options })
}

entries.build = fun() {
	ret manny.build({ targets = { dayan_library }, options = options })
}

entries.test = fun() {
	ret manny.build({ targets = { run_tests }, options = options })
}

ret entries
