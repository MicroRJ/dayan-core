dayan := elf.load_file("dayan.elf")
graph := dayan.create({ root = ".", output_directory = "build" })

options := {
	workers = 4,
	verbosity = 0,
}

entries := {}

entries.lib = fun() {
	ret manny.build({ targets = { graph.library.task }, options = options })
}

entries.build = fun() {
	ret manny.build({ targets = { graph.library.task }, options = options })
}

entries.test = fun() {
	ret manny.build({ targets = { graph.test }, options = options })
}

ret entries
